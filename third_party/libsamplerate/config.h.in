/* Local config template for the vendored libsamplerate 0.2.2 sources.
   Not an upstream file. configure_file writes the build-tree config.h. */

#define PACKAGE "libsamplerate"
#define VERSION "0.2.2"

#define CPU_CLIPS_NEGATIVE @IBMS_SRC_CPU_CLIPS_NEGATIVE@
#define CPU_CLIPS_POSITIVE @IBMS_SRC_CPU_CLIPS_POSITIVE@

#cmakedefine HAVE_STDBOOL_H
#cmakedefine HAVE_VISIBILITY

#define ENABLE_SINC_FAST_CONVERTER 1
#define ENABLE_SINC_MEDIUM_CONVERTER 1
#define ENABLE_SINC_BEST_CONVERTER 1
