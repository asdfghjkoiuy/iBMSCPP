    "beatoraja_derived_playback": {
      "commit": "e19bcc21c8d4c85d7791ff8d31d73c1cb1ea5d27",
      "refs": [
        "/tmp/ibms-timing-jbms-parser/src/bms/model/Section.java:66-145",
        "/tmp/ibms-timing-jbms-parser/src/bms/model/Section.java:296-310",
        "/tmp/ibms-timing-jbms-parser/src/bms/model/Section.java:535-551",
        "/tmp/ibms-timing-jbms-parser/src/bms/model/BMSDecoder.java:313-325"
      ],
      "rules": [
        "03 and 08 write into one BPM position map; later source row at the same fraction wins",
        "09 writes into a STOP position map; later source row at the same fraction wins; duplicate STOP values are not summed",
        "at an equal beat, BPM is applied before STOP timing is calculated",
        "STOP raw value / 192 measures = raw value / 48 quarter-beats; seconds use 60/BPM per quarter-beat",
        "a query exactly at a STOP beat reports arrival before that STOP; a later query includes the stop"
      ],
      "urls": {
        "repository": "https://github.com/exch-bms2/jbms-parser/tree/e19bcc21c8d4c85d7791ff8d31d73c1cb1ea5d27",
        "section": "https://github.com/exch-bms2/jbms-parser/blob/e19bcc21c8d4c85d7791ff8d31d73c1cb1ea5d27/src/bms/model/Section.java",
        "decoder": "https://github.com/exch-bms2/jbms-parser/blob/e19bcc21c8d4c85d7791ff8d31d73c1cb1ea5d27/src/bms/model/BMSDecoder.java"
      }
    },
    "limit": "This is a documented playback profile, not binary equivalence to a bundled jar or a claim that the VB editor is a playback engine. The newer master parser version is not asserted identical."
  },
  "query_contract": {
    "beat": "Exact absolute quarter-beat from measure ratio and row fraction.",
    "seconds": "Arrival time at the query beat. A STOP at exactly that beat is excluded from that query and included when advancing beyond it.",
    "bpm": "Initial 120; BPM changes at a beat affect following beat travel and STOP duration at that beat.",
    "ordering": "Last source definition at the same fraction wins within the BPM or STOP position map. 03 has no priority over 08; STOP entries are not summed."
  },
