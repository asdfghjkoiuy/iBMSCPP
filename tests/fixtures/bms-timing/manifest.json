        "iBMSC/iBMSC/MainWindow.vb:2281-2327"
      ],
      "stop_units": "raw STOP value / 48 quarter-beats; VB query uses value/10000 then /48",
      "known_query_caveat": "GetTimeFromVPosition can integrate a future BPM segment before the query because it uses the next BPM note as duration without clamping; this corpus uses the corrected current timeline and tests a query before a future BPM.",
      "urls": {
        "repository": "https://github.com/zardoru/iBMSC/tree/f5b21d1de50ce28202d1b2e8d2f614fabde18092",
        "chartio": "https://github.com/zardoru/iBMSC/blob/f5b21d1de50ce28202d1b2e8d2f614fabde18092/iBMSC/ChartIO.vb",
